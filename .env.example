DISCORD_TOKEN=
XKIRO_API_KEY=
# Bot replies automatically to messages in this one dedicated text channel.
DISCORD_CHANNEL_ID=
# auto routes by task; set an exact ID to disable routing.
XKIRO_MODEL=auto
# Used when the public model catalogue is unavailable, then tried as a fallback.
XKIRO_DEFAULT_MODEL=openai/gpt-5.6-sol
# Optional comma-separated fallback IDs. Pick models allowed for your xKiro account.
XKIRO_FALLBACK_MODELS=
# shared = one channel conversation; per_user = separate context for each person.
CHAT_CONTEXT_MODE=shared
# Optional: daily per-user request cap
DAILY_USER_LIMIT=30
# Context is kept in local SQLite and expires after this many hours.
HISTORY_TTL_HOURS=24
