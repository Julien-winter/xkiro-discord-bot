DISCORD_TOKEN=
XKIRO_API_KEY=
# Bot replies automatically to messages in this one dedicated text channel.
DISCORD_CHANNEL_ID=
# Model ID requested from xKiro; xKiro auto-routes provider endpoints for it.
XKIRO_MODEL=openai/gpt-5.6-sol
# Optional model-level fallback IDs if the requested model is unavailable.
XKIRO_FALLBACK_MODELS=
# Maximum alternate model requests per message; alternates may incur cost.
MAX_MODEL_FALLBACKS=1
# shared = one channel conversation; per_user = independent user contexts.
CHAT_CONTEXT_MODE=shared
# Daily request cap per user.
DAILY_USER_LIMIT=30
# SQLite conversation history expires after this many hours.
HISTORY_TTL_HOURS=24
